{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "supabase-local": {
      "type": "remote",
      "url": "http://127.0.0.1:55321/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 30000
    }
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
